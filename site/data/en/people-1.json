ols":["milesian-school"]},{"id":"cyrus-the-great","name":{"en":"Cyrus the Great"},"role":{"en":"founder of the Achaemenid Empire"},"born":-600,"died":-530,"approx":true,"lat":30.19,"lng":53.17,"place":{"en":"Pasargadae"},"region":"middle-east","category":"politics","tier":1,"bio":{"en":"Conquered Media, Lydia and Babylon to build the largest empire yet seen, and allowed the exiled Jews to return home."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Great%20Men%20and%20Famous%20Women%20Volume%201%20-%20Cyrus%20the%20Great.png?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Cyrus_the_Great"}},{"id":"mahavira","name":{"en":"Mahavira"},"role":{"en":"spiritual teacher of Jainism"},"born":-599,"died":-527,"approx":true,"lat":25.99,"lng":85.13,"place":{"en":"Vaishali"},"region":"asia","category":"culture","tier":2,"bio":{"en":"The 24th Tirthankara of Jainism, who taught non-violence (ahimsa), asceticism and the soul's liberation from karma."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Mahavir.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Mahavira"}},{"id":"laozi","name":{"en":"Laozi"},"role":{"en":"Chinese sage, founder of Taoism"},"born":-571,"died":-471,"approx":true,"lat":34.68,"lng":112.45,"place":{"en":"Luoyang (Zhou capital)"},"region":"asia","category":"culture","tier":2,"bio":{"en":"Taught the Dao, the nameless way through which all things flow, and wu wei, non-forcing action that follows the natural course. By tradition an archivist at the Zhou court and author of the Tao Te Ching."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Zhang%20Lu-Laozi%20Riding%20an%20Ox%20(cropped).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Laozi"},"schools":["taoism"]},{"id":"pythagoras","name":{"en":"Pythagoras"},"role":{"en":"Greek philosopher and mathematician"},"born":-570,"died":-495,"approx":true,"lat":39.08,"lng":17.13,"place":{"en":"Croton"},"region":"europe","category":"science","tier":1,"bio":{"en":"Founded a religious-philosophical brotherhood at Croton, taught that number underlies the world; the famous theorem bears his name."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Kapitolinischer%20Pythagoras.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Pythagoras"},"schools":["pythagoreanism"]},{"id":"gautama-buddha","name":{"en":"Gautama Buddha"},"role":{"en":"founder of Buddhism"},"born":-563,"died":-483,"approx":true,"lat":24.7,"lng":84.99,"place":{"en":"Bodh Gaya"},"region":"asia","category":"culture","tier":1,"bio":{"en":"Prince Siddhartha Gautama renounced his palace to seek truth, attained enlightenment and taught a path to liberation from suffering."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Buddha%20in%20Sarnath%20Museum%20(Dhammajak%20Mutra).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/The_Buddha"},"schools":["buddhist-philosophy"]},{"id":"confucius","name":{"en":"Confucius"},"role":{"en":"Chinese philosopher"},"born":-551,"died":-479,"approx":false,"lat":35.6,"lng":116.99,"place":{"en":"Qufu (State of Lu)"},"region":"asia","category":"culture","tier":1,"bio":{"en":"Teacher from the State of Lu whose ideas on virtue, ritual and filial piety shaped Chinese civilisation for two millennia."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Confucius%2C%20fresco%20from%20a%20Western%20Han%20tomb%20of%20Dongping%20County%2C%20Shandong%20province%2C%20China.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Confucius"},"schools":["confucianism"]},{"id":"darius-i","name":{"en":"Darius the Great"},"role":{"en":"King of Kings of the Achaemenid Empire"},"born":-550,"died":-486,"approx":true,"lat":29.93,"lng":52.89,"place":{"en":"Persepolis"},"region":"middle-east","category":"politics","tier":2,"bio":{"en":"Organised the empire into satrapies, introduced coinage and the Royal Road, founded Persepolis; his invasion of Greece failed at Marathon."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Darius%20the%20great.%20jpg.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Darius_the_Great"}},{"id":"sun-tzu","name":{"en":"Sun Tzu"},"role":{"en":"Chinese military strategist"},"born":-544,"died":-496,"approx":true,"lat":31.3,"lng":120.62,"place":{"en":"State of Wu (Suzhou)"},"region":"asia","category":"war","tier":2,"bio":{"en":"General of the State of Wu traditionally credited with The Art of War, the most influential treatise on strategy."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/%E5%90%B4%E5%8F%B8%E9%A9%AC%E5%AD%99%E6%AD%A6.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Sun_Tzu"}},{"id":"leonidas-i","name":{"en":"Leonidas I"},"role":{"en":"king of Sparta"},"born":-540,"died":-480,"approx":true,"lat":37.07,"lng":22.43,"place":{"en":"Sparta"},"region":"europe","category":"war","tier":2,"bio":{"en":"Spartan king who died with his 300 men at Thermopylae holding back the army of Xerxes."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Leonidas%20Statue.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Leonidas_I"}},{"id":"heraclitus","name":{"en":"Heraclitus"},"role":{"en":"Greek philosopher"},"born":-535,"died":-475,"approx":true,"lat":37.94,"lng":27.34,"place":{"en":"Ephesus"},"region":"middle-east","category":"culture","tier":3,"bio":{"en":"Philosopher of constant change ('everything flows') and the unity of opposites, nicknamed 'the Obscure'."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Ca'%20Rezzonico%20-%20Eraclito%201705%20-%20Giuseppe%20Torretti.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Heraclitus"}},{"id":"themistocles","name":{"en":"Themistocles"},"role":{"en":"Athenian statesman and admiral"},"born":-524,"died":-459,"approx":true,"lat":37.96,"lng":23.64,"place":{"en":"Athens (Piraeus)"},"region":"europe","category":"war","tier":3,"bio":{"en":"Built the Athenian navy and masterminded the victory over the Persians at Salamis in 480 BC."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Illustrerad%20Verldshistoria%20band%20I%20Ill%20116.png?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Themistocles"}},{"id":"xerxes-i","name":{"en":"Xerxes I"},"role":{"en":"king of the Achaemenid Empire"},"born":-518,"died":-465,"approx":true,"lat":32.19,"lng":48.26,"place":{"en":"Susa"},"region":"middle-east","category":"politics","tier":2,"bio":{"en":"Son of Darius I who led the great invasion of Greece in 480 BC, defeated at Salamis and Plataea."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/National%20Museum%20of%20Iran%20Darafsh%20(784).JPG?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Xerxes_I"}},{"id":"parmenides","name":{"en":"Parmenides"},"role":{"en":"Greek philosopher, founder of the Eleatic school"},"born":-515,"died":-470,"approx":true,"lat":40.16,"lng":15.15,"place":{"en":"Elea"},"region":"europe","category":"culture","tier":3,"bio":{"en":"Author of the poem On Nature. He argued that being is one, unchanging and eternal, and that change and plurality are illusions of the senses."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Busto%20di%20Parmenide%20(cropped).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Parmenides"},"schools":["eleatics"]},{"id":"sophocles","name":{"en":"Sophocles"},"role":{"en":"Athenian tragic playwright"},"born":-497,"died":-406,"approx":true,"lat":37.97,"lng":23.73,"place":{"en":"Athens"},"region":"europe","category":"culture","tier":2,"bio":{"en":"One of the three great Athenian tragedians, author of Oedipus Rex and Antigone."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Ny%20Carlsberg%20Glyptothek%20-%20Sophokles.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Sophocles"}},{"id":"pericles","name":{"en":"Pericles"},"role":{"en":"Athenian statesman"},"born":-495,"died":-429,"approx":true,"lat":37.97,"lng":23.72,"place":{"en":"Athens"},"region":"europe","category":"politics","tier":2,"bio":{"en":"Led Athens at its zenith, strengthening democracy and launching the Parthenon; the 'Age of Pericles' is named after him."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Pericles%20Pio-Clementino%20Inv269.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Pericles"}},{"id":"zeno-of-elea","name":{"en":"Zeno of Elea"},"role":{"en":"Greek philosopher of the Eleatic school"},"born":-490,"died":-430,"approx":true,"lat":40.16,"lng":15.15,"place":{"en":"Elea"},"region":"europe","category":"culture","tier":3,"bio":{"en":"A pupil of Parmenides, famous for paradoxes such as Achilles and the Tortoise, which aimed to show that our ideas of motion and plurality lead to contradictions."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Portretbuste%20van%20Zeno%20van%20Elea%20Paradigmata%20graphices%20variorum%20artificum%20(serietitel)%2C%20RP-P-1907-4495.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Zeno_of_Elea"},"schools":["eleatics"]},{"id":"protagoras","name":{"en":"Protagoras"},"role":{"en":"Greek sophist philosopher"},"born":-490,"died":-420,"approx":true,"lat":37.97,"lng":23.73,"place":{"en":"Athens"},"region":"europe","category":"culture","tier":3,"bio":{"en":"One of the first to charge fees for teaching wisdom and rhetoric. He is known for the saying \"Man is the measure of all things\"."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Salvator%20Rosa%20-%20D%C3%A9mocrite%20et%20Protagoras.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Protagoras"},"schools":["sophists"]},{"id":"herodotus","name":{"en":"Herodotus"},"role":{"en":"ancient Greek historian"},"born":-484,"died":-425,"approx":true,"lat":37.04,"lng":27.42,"place":{"en":"Halicarnassus"},"region":"middle-east","category":"culture","tier":2,"bio":{"en":"The 'Father of History', whose Histories recount the Greco-Persian Wars and the customs of the known world."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Marble%20bust%20of%20Herodotos%20MET%20DT11742%20(cropped).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Herodotus"}},{"id":"phidias","name":{"en":"Phidias"},"role":{"en":"ancient Greek sculptor"},"born":-480,"died":-430,"approx":true,"lat":37.97,"lng":23.73,"place":{"en":"Athens"},"region":"europe","category":"culture","tier":2,"bio":{"en":"Directed the Parthenon sculptures and made the Athena Parthenos and the Statue of Zeus at Olympia, a Wonder of the World."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/The%20Sculptor%20Phidias-Ny%20Carlsberg%20Glyptotek.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Phidias"}},{"id":"socrates","name":{"en":"Socrates"},"role":{"en":"Athenian philosopher"},"born":-470,"died":-399,"approx":true,"lat":37.98,"lng":23.72,"place":{"en":"Athens"},"region":"europe","category":"culture","tier":1,"bio":{"en":"Philosopher who sought truth through questioning dialogue and wrote nothing; condemned by Athens, he drank hemlock."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Socrates%20Louvre.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Socrates"}},{"id":"aspasia","name":{"en":"Aspasia"},"role":{"en":"intellectual, partner of Pericles"},"born":-470,"died":-400,"approx":true,"lat":37.97,"lng":23.74,"place":{"en":"Athens"},"region":"europe","category":"culture","tier":3,"bio":{"en":"Milesian-born partner of Pericles, famed for her intellect and rhetoric; her home was a hub of Athenian intellectual life."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Aspasie%20-%20Mus%C3%A9e%20de%20Pergame%20-%20Berlin.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Aspasia"}},{"id":"mozi","name":{"en":"Mozi"},"role":{"en":"Chinese philosopher, founder of Mohism"},"born":-470,"died":-391,"approx":true,"lat":35.08,"lng":117.15,"place":{"en":"Tengzhou (State of Lu)"},"region":"asia","category":"culture","tier":3,"bio":{"en":"Preached \"impartial care\", concern for all people equally rather than for one's kin alone, and condemned wars of conquest. His followers were renowned experts in defensive fortification."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/%D0%A4%D0%B8%D0%BB%D0%BE%D1%81%D0%BE%D1%84%20%D0%9C%D0%BE-%D0%A6%D0%B7%D1%8B.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Mozi"},"schools":["mohism"]},{"id":"hippocrates","name":{"en":"Hippocrates"},"role":{"en":"ancient Greek physician"},"born":-460,"died":-370,"approx":true,"lat":36.89,"lng":27.29,"place":{"en":"Kos"},"region":"europe","category":"science","tier":2,"bio":{"en":"The 'Father of Medicine', who explained disease by natural causes rather than the gods; the physicians' oath bears his name."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Hippocrates%20rubens.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Hippocrates"}},{"id":"democritus","name":{"en":"Democritus"},"role":{"en":"ancient Greek atomist philosopher"},"born":-460,"died":-370,"approx":true,"lat":40.95,"lng":24.98,"place":{"en":"Abdera"},"region":"europe","category":"science","tier":2,"bio":{"en":"With his teacher Leucippus he taught that the world consists of indivisible atoms moving in a void, with all things being their combinations. Ancient writers called him the \"laughing philosopher\"."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Bust%20of%20an%20unknown%20Greek%20-%20Museo%20archeologico%20nazionale%20di%20Napoli.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Democritus"},"schools":["atomism"]},{"id":"antisthenes","name":{"en":"Antisthenes"},"role":{"en":"Greek philosopher, pupil of Socrates"},"born":-445,"died":-365,"approx":true,"lat":37.97,"lng":23.73,"place":{"en":"Athens"},"region":"europe","category":"culture","tier":3,"bio":{"en":"A pupil of Socrates who taught that virtue is the only good and that wealth and fame are worthless. Ancient writers regarded him as the founder of Cynicism."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Antisthenes%20BM%201838.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Antisthenes"},"schools":["cynicism"]},{"id":"plato","name":{"en":"Plato"},"role":{"en":"ancient Greek philosopher"},"born":-428,"died":-348,"approx":true,"lat":37.99,"lng":23.71,"place":{"en":"Athens (the Academy)"},"region":"europe","category":"culture","tier":1,"bio":{"en":"Student of Socrates and founder of the Academy; his dialogues, including the Republic, set out the theory of Forms."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Plato%20Silanion%20Musei%20Capitolini%20MC1377.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Plato"},"schools":["platonic-academy"]},{"id":"diogenes-of-sinope","name":{"en":"Diogenes of Sinope"},"role":{"en":"ancient Greek Cynic philosopher"},"born":-412,"died":-323,"approx":true,"lat":37.91,"lng":22.88,"place":{"en":"Corinth"},"region":"europe","category":"culture","tier":3,"bio":{"en":"The best-known Cynic: he taught living simply and according to nature, scorning wealth, fame and convention. Legend says he lived in a clay jar and asked Alexander the Great to stand out of his sunlight."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Diogenes-statue-Sinop-enhanced.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Diogenes"},"schools":["cynicism"]},{"id":"shang-yang","name":{"en":"Shang Yang"},"role":{"en":"Qin statesman and Legalist"},"born":-390,"died":-338,"approx":true,"lat":34.33,"lng":108.71,"place":{"en":"Xianyang (state of Qin)"},"region":"asia","category":"politics","tier":3,"bio":{"en":"Chancellor of the state of Qin. His reforms — uniform harsh laws, rewards for farming and military merit, collective responsibility — made Qin the strongest of the states. He was executed after his patron died."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Statue%20of%20Shang%20Yang.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Shang_Yang"},"schools":["legalism"]},{"id":"aristotle","name":{"en":"Aristotle"},"role":{"en":"ancient Greek philosopher and scientist"},"born":-384,"died":-322,"approx":false,"lat":37.98,"lng":23.74,"place":{"en":"Athens (the Lyceum)"},"region":"europe","category":"science","tier":1,"bio":{"en":"Student of Plato, tutor of Alexander and founder of the Lyceum; he laid the foundations of logic, biology, ethics and politics."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Aristotle%20Altemps%20Inv8575.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Aristotle"},"schools":["platonic-academy","peripatetic-school"]},{"id":"olympias","name":{"en":"Olympias"},"role":{"en":"queen of Macedon, mother of Alexander"},"born":-375,"died":-316,"approx":true,"lat":40.76,"lng":22.52,"place":{"en":"Pella"},"region":"europe","category":"politics","tier":3,"bio":{"en":"Epirote princess, wife of Philip II and mother of Alexander the Great, who fought for power in the wars of the Diadochi."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Coin%20olympias%20mus%20theski.JPG?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Olympias"}},{"id":"mencius","name":{"en":"Mencius"},"role":{"en":"Chinese Confucian philosopher"},"born":-372,"died":-289,"approx":true,"lat":35.4,"lng":116.97,"place":{"en":"State of Zou"},"region":"asia","category":"culture","tier":2,"bio":{"en":"Greatest successor of Confucius, who taught that human nature is innately good and rulers must govern benevolently."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Half%20Portraits%20of%20the%20Great%20Sage%20and%20Virtuous%20Men%20of%20Old%20-%20Meng%20Ke%20(%E5%AD%9F%E8%BB%BB).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Mencius"},"schools":["confucianism"]},{"id":"zhuangzi","name":{"en":"Zhuangzi"},"role":{"en":"Chinese Taoist philosopher"},"born":-369,"died":-286,"approx":true,"lat":34.41,"lng":115.65,"place":{"en":"Meng (State of Song)"},"region":"asia","category":"culture","tier":3,"bio":{"en":"Taoist thinker whose parables on freedom and the relativity of knowledge include the famous butterfly dream."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Zhuangzi.png?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Zhuang_Zhou"},"schools":["taoism"]},{"id":"ptolemy-i-soter","name":{"en":"Ptolemy I Soter"},"role":{"en":"founder of the Ptolemaic dynasty"},"born":-367,"died":-282,"approx":true,"lat":31.2,"lng":29.92,"place":{"en":"Alexandria"},"region":"africa","category":"politics","tier":3,"bio":{"en":"General of Alexander who became king of Egypt after his death and founded the Museum and Library of Alexandria."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Ptolemy%20I%20Soter%20Louvre%20Ma849%20A.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Ptolemy_I_Soter"}},{"id":"pyrrho","name":{"en":"Pyrrho"},"role":{"en":"Greek philosopher, founder of Pyrrhonism"},"born":-360,"died":-270,"approx":true,"lat":37.89,"lng":21.37,"place":{"en":"Elis"},"region":"europe","category":"culture","tier":3,"bio":{"en":"Travelled with Alexander the Great as far as India. He taught suspension of judgement: nothing can be known for certain about the nature of things, and tranquillity follows once one stops insisting."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Pyrrho%20Heliensis%20-%20Illustrium%20philosophorum%20et%20sapientum%20effigies%20ab%20eorum%20numistatibus%20extractae.png?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Pyrrho"},"schools":["pyrrhonism"]},{"id":"alexander-the-great","name":{"en":"Alexander the Great"},"role":{"en":"king of Macedon and conqueror"},"born":-356,"died":-323,"approx":false,"lat":32.54,"lng":44.42,"place":{"en":"Babylon"},"region":"middle-east","category":"war","tier":1,"bio":{"en":"In 11 years he destroyed the Persian Empire and reached India, opening the Hellenistic age; he died in Babylon aged 32."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Alexander%20the%20Great%20mosaic%20(cropped).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Alexander_the_Great"}},{"id":"pytheas","name":{"en":"Pytheas"},"role":{"en":"Greek navigator and geographer"},"born":-350,"died":-285,"approx":true,"lat":43.3,"lng":5.37,"place":{"en":"Massalia"},"region":"europe","category":"exploration","tier":3,"bio":{"en":"Navigator from Massalia who circumnavigated Britain and first described distant Thule and the midnight sun."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Pyth%C3%A9as.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Pytheas"}},{"id":"epicurus","name":{"en":"Epicurus"},"role":{"en":"ancient Greek philosopher"},"born":-341,"died":-270,"approx":false,"lat":37.98,"lng":23.7,"place":{"en":"Athens (the Garden)"},"region":"europe","category":"culture","tier":2,"bio":{"en":"Taught that the goal of life is pleasure, understood as freedom from bodily pain and mental distress, reached through friendship, simple living and freedom from fear of death. His school met in a garden."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Epicurus%20Massimo%20Inv197306.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Epicurus"},"schools":["epicureanism"]},{"id":"chandragupta-maurya","name":{"en":"Chandragupta Maurya"},"role":{"en":"founder of the Maurya Empire"},"born":-340,"died":-297,"approx":true,"lat":25.61,"lng":85.14,"place":{"en":"Pataliputra"},"region":"asia","category":"politics","tier":2,"bio":{"en":"Overthrew the Nanda dynasty and united most of India, gaining the north-west from Seleucus I."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Chandragupt%20maurya%20Birla%20mandir%206%20dec%202009%20(31)%20(cropped).JPG?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Chandragupta_Maurya"}},{"id":"qu-yuan","name":{"en":"Qu Yuan"},"role":{"en":"Chinese poet and minister"},"born":-340,"died":-278,"approx":true,"lat":30.35,"lng":112.19,"place":{"en":"Ying (State of Chu)"},"region":"asia","category":"culture","tier":3,"bio":{"en":"China's first known named poet, author of Li Sao; the Dragon Boat Festival commemorates him."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Qu%20Yuan%20Chen%20Hongshou%202.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Qu_Yuan"}},{"id":"zeno-of-citium","name":{"en":"Zeno of Citium"},"role":{"en":"ancient Greek philosopher, founder of Stoicism"},"born":-334,"died":-262,"approx":true,"lat":37.976,"lng":23.722,"place":{"en":"Athens (Painted Stoa)"},"region":"europe","category":"culture","tier":3,"bio":{"en":"Founder of Stoicism: happiness lies in virtue and living in accord with reason and nature, accepting calmly whatever is beyond our control. The school was named after the Painted Stoa, the porch where he taught."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Paolo%20Monti%20-%20Servizio%20fotografico%20(Napoli%2C%201969)%20-%20BEIC%206353768.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Zeno_of_Citium"},"schools":["stoicism"]},{"id":"euclid","name":{"en":"Euclid"},"role":{"en":"ancient Greek mathematician"},"born":-325,"died":-270,"approx":true,"lat":31.21,"lng":29.91,"place":{"en":"Alexandria"},"region":"africa","category":"science","tier":2,"bio":{"en":"Author of the Elements, the systematic treatment of geometry that served as the main mathematics textbook for 2,000 years."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Euklid2.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Euclid"}},{"id":"arsinoe-ii","name":{"en":"Arsinoe II"},"role":{"en":"queen of Ptolemaic Egypt"},"born":-316,"died":-270,"approx":true,"lat":31.19,"lng":29.9,"place":{"en":"Alexandria"},"region":"africa","category":"politics","tier":3,"bio":{"en":"Queen of Thrace, then wife and co-ruler of her brother Ptolemy II; she was deified in her lifetime."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/ArsinoeII.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Arsinoe_II"}},{"id":"xunzi","name":{"en":"Xunzi"},"role":{"en":"Chinese Confucian philosopher"},"born":-310,"died":-235,"approx":true,"lat":36.85,"lng":118.33,"place":{"en":"Linzi (Jixia Academy)"},"region":"asia","category":"culture","tier":3,"bio":{"en":"Confucian who held that human nature is originally bad and that virtue must be cultivated through learning and ritual. Teacher of Han Fei and Li Si."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Portrait%20of%20Xun%20Zi.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Xunzi_(philosopher)"},"schools":["confucianism"]},{"id":"ashoka","name":{"en":"Ashoka"},"role":{"en":"Maurya emperor"},"born":-304,"died":-232,"approx":true,"lat":25.6,"lng":85.13,"place":{"en":"Pataliputra"},"region":"asia","category":"politics","tier":2,"bio":{"en":"United almost all of India but, shocked by the Kalinga war, embraced Buddhism and spread it across Asia."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Ashoka's%20visit%20to%20the%20Ramagrama%20stupa%20Sanchi%20Stupa%201%20Southern%20gateway.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Ashoka"}},{"id":"archimedes","name":{"en":"Archimedes"},"role":{"en":"mathematician, physicist and engineer"},"born":-287,"died":-212,"approx":true,"lat":37.08,"lng":15.29,"place":{"en":"Syracuse"},"region":"europe","category":"science","tier":1,"bio":{"en":"Discovered the law of buoyancy and the lever, approximated π; his machines defended Syracuse, and he died when Rome took the city."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Retrato%20de%20un%20erudito%20(%C2%BFArqu%C3%ADmedes%3F)%2C%20por%20Domenico%20Fetti.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Archimedes"}},{"id":"han-fei","name":{"en":"Han Fei"},"role":{"en":"Chinese Legalist philosopher"},"born":-280,"died":-233,"approx":true,"lat":34.39,"lng":113.74,"place":{"en":"Xinzheng (State of Han)"},"region":"asia","category":"culture","tier":3,"bio":{"en":"Chief theorist of Legalism: a state rests on strict laws, rewards and punishments rather than on the ruler's virtue. Qin Shi Huang adopted his ideas."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Statue%20Of%20Han%20Fei.png?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Han_Fei"},"schools":["legalism"]},{"id":"eratosthenes","name":{"en":"Eratosthenes"},"role":{"en":"scholar, head of the Library of Alexandria"},"born":-276,"died":-194,"approx":true,"lat":31.2,"lng":29.91,"place":{"en":"Alexandria"},"region":"africa","category":"science","tier":2,"bio":{"en":"First to measure Earth's circumference with remarkable accuracy; founded scientific geography and devised the prime-number sieve."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Eratosthenes.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Eratosthenes"}},{"id":"qin-shi-huang","name":{"en":"Qin Shi Huang"},"role":{"en":"first emperor of China"},"born":-259,"died":-210,"approx":false,"lat":34.33,"lng":108.71,"place":{"en":"Xianyang"},"region":"asia","category":"politics","tier":1,"bio":{"en":"Unified China in 221 BC, standardised script, weights and coinage and began the Great Wall; buried with the Terracotta Army."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Qinshihuangdi3.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Qin_Shi_Huang"}},{"id":"liu-bang","name":{"en":"Liu Bang (Emperor Gaozu of Han)"},"role":{"en":"founder of the Han dynasty"},"born":-256,"died":-195,"approx":true,"lat":34.27,"lng":108.94,"place":{"en":"Chang'an"},"region":"asia","category":"politics","tier":2,"bio":{"en":"A commoner who defeated Xiang Yu after the fall of Qin and founded the Han dynasty, which lasted four centuries."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Liu-bang.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Emperor_Gaozu_of_Han"}},{"id":"hannibal","name":{"en":"Hannibal"},"role":{"en":"Carthaginian general"},"born":-247,"died":-183,"approx":true,"lat":36.85,"lng":10.32,"place":{"en":"Carthage"},"region":"africa","category":"war","tier":1,"bio":{"en":"Crossed the Alps with elephants and crushed Rome at Cannae in the Second Punic War; defeated by Scipio at Zama."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Mommsen%20p265.jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Hannibal"}},{"id":"empress-lu","name":{"en":"Empress Lü (Lü Zhi)"},"role":{"en":"Han empress and regent"},"born":-241,"died":-180,"approx":false,"lat":34.28,"lng":108.95,"place":{"en":"Chang'an"},"region":"asia","category":"politics","tier":3,"bio":{"en":"Wife of Liu Bang who effectively ruled China for 15 years after his death, the first woman to hold imperial power."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/WUL-he21%2001467%20%E6%96%B0%E9%90%AB%E7%B9%AA%E5%83%8F%E6%9D%B1%E8%A5%BF%E6%BC%A2%E5%85%A8%E5%82%B3%2001%20(%E5%91%82%E5%90%8E).jpg?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Empress_Lü"}},{"id":"scipio-africanus","name":{"en":"Scipio Africanus"},"role":{"en":"Roman general"},"born":-236,"died":-183,"approx":false,"lat":41.89,"lng":12.49,"place":{"en":"Rome"},"region":"europe","category":"war","tier":2,"bio":{"en":"Defeated Hannibal at Zama in 202 BC, ending the Second Punic War."},"portrait":"https://commons.wikimedia.org/wiki/Special:FilePath/Escipi%C3%B3n%20africano.JPG?width=160","wikipedia":{"en":"https://en.wikipedia.org/wiki/Scipio_Africanus"}},{"id":"cato-the-elder","name":{