_Muslim_conquests"},{"id":"srivijaya","from":650,"to":1377,"approx":true,"region":"asia","kind":"era","tier":3,"title":{"en":"Srivijaya"},"summary":{"en":"A maritime power on Sumatra that controlled the Strait of Malacca and India–China trade."},"wikipedia":"https://en.wikipedia.org/wiki/Srivijaya"},{"id":"trans-saharan-trade","from":700,"to":1600,"approx":true,"region":"africa","kind":"process","tier":3,"title":{"en":"Trans-Saharan trade"},"summary":{"en":"Caravan trade in gold, salt and slaves across the Sahara between North Africa and the Sahel."},"wikipedia":"https://en.wikipedia.org/wiki/Trans-Saharan_trade"},{"id":"reconquista","from":711,"to":1492,"approx":true,"region":"europe","kind":"war","tier":2,"title":{"en":"Reconquista"},"summary":{"en":"Centuries-long campaign by Christian kingdoms to take the Iberian Peninsula from Muslim rule."},"wikipedia":"https://en.wikipedia.org/wiki/Reconquista"},{"id":"islamic-golden-age","from":750,"to":1258,"approx":true,"region":"middle-east","kind":"culture","tier":1,"title":{"en":"Islamic Golden Age"},"summary":{"en":"Flourishing of science, philosophy and the arts in the Islamic world, centred on Baghdad."},"wikipedia":"https://en.wikipedia.org/wiki/Islamic_Golden_Age"},{"id":"viking-age","from":793,"to":1066,"approx":true,"region":"europe","kind":"era","tier":2,"title":{"en":"Viking Age"},"summary":{"en":"Scandinavian raids, trade and settlement from Britain to Rus' and North America."},"wikipedia":"https://en.wikipedia.org/wiki/Viking_Age"},{"id":"swahili-coast-trade","from":800,"to":1500,"approx":true,"region":"africa","kind":"process","tier":3,"title":{"en":"Rise of the Swahili city-states"},"summary":{"en":"Kilwa, Mombasa and Zanzibar linked Africa with Arabia, India and China through monsoon trade."},"wikipedia":"https://en.wikipedia.org/wiki/Swahili_coast"},{"id":"mississippian-culture","from":800,"to":1600,"approx":true,"region":"americas","kind":"era","tier":3,"title":{"en":"Mississippian culture"},"summary":{"