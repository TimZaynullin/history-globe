ipedia":"https://en.wikipedia.org/wiki/Safavid_Iran"},{"id":"reformation","from":1517,"to":1648,"approx":true,"region":"europe","kind":"process","tier":1,"title":{"en":"Reformation"},"summary":{"en":"Religious movement launched by Luther that split Western Christianity."},"wikipedia":"https://en.wikipedia.org/wiki/Reformation"},{"id":"spanish-conquest-of-the-aztec-empire","from":1519,"to":1521,"approx":false,"region":"americas","kind":"war","tier":3,"title":{"en":"Spanish conquest of the Aztec Empire"},"summary":{"en":"Conquest of the Aztec Empire by Hernán Cortés and his Indigenous allies."},"wikipedia":"https://en.wikipedia.org/wiki/Spanish_conquest_of_the_Aztec_Empire"},{"id":"spanish-conquest-of-the-inca-empire","from":1532,"to":1572,"approx":false,"region":"americas","kind":"war","tier":3,"title":{"en":"Spanish conquest of the Inca Empire"},"summary":{"en":"Conquest of the Inca Empire by Spaniards led by Francisco Pizarro."},"wikipedia":"https://en.wikipedia.org/wiki/Spanish_conquest_of_the_Inca_Empire"},{"id":"scientific-revolution","from":1543,"to":1687,"approx":true,"region":"europe","kind":"culture","tier":3,"title":{"en":"Scientific Revolution"},"summary":{"en":"Emergence of modern science, from Copernicus to Newton's Principia."},"wikipedia":"https://en.wikipedia.org/wiki/Scientific_Revolution"},{"id":"mughal-golden-age","from":1556,"to":1707,"approx":true,"region":"asia","kind":"era","tier":3,"title":{"en":"Mughal golden age"},"summary":{"en":"Height of the Mughal Empire from Akbar to Aurangzeb, the age of the Taj Mahal."},"wikipedia":"https://en.wikipedia.org/wiki/Mughal_Empire"},{"id":"livonian-war","from":1558,"to":1583,"approx":false,"region":"russia","kind":"war","tier":3,"title":{"en":"Livonian War"},"summary":{"en":"Tsardom of Russia's war for the Baltic against the Livonian Order, Poland–Lithuania and Sweden."},"wikipedia":"https://en.wikipedia.org/wiki/Livonian_War"},{"id":"imjin-war","from":1592,"to":1598,"approx":false,"region":"asia","kind":"