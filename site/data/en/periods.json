ia.org/wiki/Achaemenid_Empire"},{"id":"roman-republic","from":-509,"to":-27,"approx":true,"region":"europe","kind":"era","tier":2,"title":{"en":"Roman Republic"},"summary":{"en":"Republican rule in Rome from the expulsion of the kings to the principate of Augustus."},"wikipedia":"https://en.wikipedia.org/wiki/Roman_Republic"},{"id":"greco-persian-wars","from":-499,"to":-449,"approx":true,"region":"middle-east","kind":"war","tier":2,"title":{"en":"Greco-Persian Wars"},"summary":{"en":"Wars between the Achaemenid Empire and the Greek city-states: Marathon, Thermopylae, Salamis."},"wikipedia":"https://en.wikipedia.org/wiki/Greco-Persian_Wars"},{"id":"classical-greece","from":-480,"to":-323,"approx":true,"region":"europe","kind":"era","tier":1,"title":{"en":"Classical Greece"},"summary":{"en":"Height of the Greek city-states: Athenian democracy, philosophy, drama and the Peloponnesian War."},"wikipedia":"https://en.wikipedia.org/wiki/Classical_Greece"},{"id":"warring-states-period","from":-475,"to":-221,"approx":true,"region":"asia","kind":"era","tier":2,"title":{"en":"Warring States period"},"summary":{"en":"Era of war between Chinese states, ending with unification under the Qin."},"wikipedia":"https://en.wikipedia.org/wiki/Warring_States_period"},{"id":"hellenistic-period","from":-323,"to":-31,"approx":true,"region":"europe","kind":"era","tier":2,"title":{"en":"Hellenistic period"},"summary":{"en":"Era after Alexander the Great's conquests, when Greek culture spread as far as India."},"wikipedia":"https://en.wikipedia.org/wiki/Hellenistic_period"},{"id":"maurya-empire","from":-322,"to":-185,"approx":true,"region":"asia","kind":"era","tier":2,"title":{"en":"Maurya Empire"},"summary":{"en":"The first state to unite most of India; under Ashoka, a patron of Buddhism."},"wikipedia":"https://en.wikipedia.org/wiki/Maurya_Empire"},{"id":"punic-wars","from":-264,"to":-146,"approx":false,"region":"europe","kind":"war","tier":3,"title":{"en":"Punic Wars"},"summary":{"en":"Three