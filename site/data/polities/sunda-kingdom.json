{"key":"sunda-kingdom","name":{"ru":"Королевство Сунда","en":"Sunda Kingdom"},"group":false,"from":674,"to":1578,"founded":669,"dissolved":1579,"area":[[674,723,26774],[724,731,62499],[732,740,121225],[741,824,26774],[825,895,62041],[896,1027,26774],[1028,1293,62041],[1294,1474,62271],[1475,1481,26774],[1482,1518,54103],[1519,1528,53873],[1529,1571,44266],[1572,1578,22146]],"capitals":[{"key":null,"ru":"Пакуан Паджаджаран","en":"Pakuan Pajajaran","from":null,"to":null},{"key":null,"ru":"Кавали","en":"Kawali","from":null,"to":null}],"flag":null,"coat":null,"predecessors":[{"key":"tarumanagara","ru":"Тарума","en":"Tarumanagara"}],"successors":[],"summary":{"ru":"Королевство Сунда было индуистским королевством сундов, расположенным в западной части острова Ява с 669 по 1579 годы, на территории современного Бантама, Джакарты, западной Явы и западной части центральной Явы. Столица королевства Сунда меняла своё местоположение и находилась в Кавали в Галухе на востоке и в Пакуан Паджаджаран на западе.","en":null},"wikipedia":{"ru":"https://ru.wikipedia.org/wiki/%D0%A1%D1%83%D0%BD%D0%B4%D0%B0_(%D0%BA%D0%BE%D1%80%D0%BE%D0%BB%D0%B5%D0%B2%D1%81%D1%82%D0%B2%D0%BE)","en":null},"wikidata":"Q1469742"}