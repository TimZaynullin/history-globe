{"key":"kazakh-khanate","name":{"ru":"Казахское ханство","en":"Kazakh Khanate"},"group":false,"from":1468,"to":1847,"founded":1456,"dissolved":1847,"area":[[1468,1474,161350],[1475,1481,739787],[1482,1486,1925314],[1487,1491,2323406],[1492,1496,2323429],[1497,1501,1864454],[1502,1511,1738223],[1512,1515,1738199],[1516,1518,1736247],[1519,1520,1736063],[1521,1528,2400405],[1529,1555,2400538],[1556,1571,2400625],[1572,1587,2556969],[1588,1594,2559796],[1595,1599,2652599],[1600,1608,2652434],[1609,1635,2559568],[1636,1658,2213712],[1659,1676,2213689],[1677,1682,2213712],[1683,1686,2201123],[1687,1717,2213712],[1718,1720,2210720],[1721,1737,2187694],[1738,1743,2135120],[1744,1747,2135674],[1748,1751,2136638],[1752,1756,2135588],[1757,1761,2133742],[1762,1762,2135564],[1763,1768,2135750],[1769,1771,2122417],[1772,1782,2122279],[1783,1787,2122417],[1788,1790,2122693],[1791,1795,1906111],[1796,1802,1904289],[1803,1804,1903851],[1805,1808,1904289],[1809,1821,1815737],[1822,1845,1709236],[1846,1847,1709236]],"capitals":[{"key":null,"ru":"Созак","en":"Sozak","from":1465,"to":1469},{"key":null,"ru":"Сыгнак","en":"Sighnaq","from":1469,"to":1511},{"key":null,"ru":"Сарайчик","en":"Saray-Jük","from":1511,"to":1521},{"key":null,"ru":"Туркестан","en":"Turkistan","from":1599,"to":1729},{"key":null,"ru":"Ташкент","en":"Tashkent","from":1729,"to":1781},{"key":null,"ru":"Сыгнак","en":"Sighnaq","from":1521,"to":1599}],"flag":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag%20of%20the%20Kazakh%20Khanate.svg?width=160","coat":null,"predecessors":[],"successors":[{"key":null,"ru":"Старший жуз","en":"Senior jüz"}],"summary":{"ru":"Казахское ханство — казахское государство, существовавшее с XV до начала XIX века, одно из государств-наследников Золотой Орды. Его основали соправители Керей и Джанибек; наивысшего расцвета ханство достигло при Касыме, Хак-Назаре, Тауекеле и Есиме, когда власть казахов распространялась на обширные степи к востоку от Каспийского и к северу от Аральского моря вплоть до верховьев Иртыша. В XVII—XVIII веках ханство пришло в упадок, а после смерти Тауке-хана фактически распалось на три независимых ханства.","en":"The Kazakh Khanate, also known as the Kazakh Khanates or Qazaq Khanate was a nomadic state in Central Asia that existed from c. 1465 to the early 19th century. It emerged after the fragmentation of the Golden Horde."},"wikipedia":{"ru":"https://ru.wikipedia.org/wiki/%D0%9A%D0%B0%D0%B7%D0%B0%D1%85%D1%81%D0%BA%D0%BE%D0%B5_%D1%85%D0%B0%D0%BD%D1%81%D1%82%D0%B2%D0%BE","en":"https://en.wikipedia.org/wiki/Kazakh_Khanate"},"wikidata":"Q1433867"}