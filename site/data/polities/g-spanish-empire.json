,1294162],[1895,1897,1238621],[1898,1899,1230176],[1900,1904,840687],[1905,1910,839518],[1911,1911,839950],[1912,1921,854141],[1922,1923,848784],[1924,1925,843913],[1926,1929,854141],[1930,1931,854141]],"capitals":[{"key":null,"ru":"Мадрид-сити","en":"Madrid city","from":1606,"to":null},{"key":null,"ru":"Toledo city","en":"Toledo city","from":null,"to":null},{"key":null,"ru":"Valladolid city","en":"Valladolid city","from":null,"to":null}],"flag":"https://commons.wikimedia.org/wiki/Special:FilePath/Flag%20of%20Spain%20(1873%E2%80%931874).svg?width=160","coat":null,"predecessors":[{"key":"crown-of-aragon","ru":"Арагонская корона","en":"Crown of Aragon"},{"key":"crown-of-castile","ru":"Корона Кастилии","en":"Crown of Castile"}],"successors":[{"key":"kingdom-of-spain","ru":"Испания","en":"Kingdom of Spain"}],"summary":{"ru":"Испанская империя — совокупность территорий и колоний, которые находились под прямым управлением Испании в Европе, Америке, Африке, Азии и Океании. Испанская империя на вершине своего могущества была одной из крупнейших империй в мировой истории. Её создание связано с началом эпохи Великих географических открытий, в ходе которых она стала одной из первых колониальных империй. Испанская империя существовала с XV столетия до (в случае с африканскими владениями) конца XX века. Испанские территории объединились в конце 1480-х годов с унией Католических королей: короля Арагона и королевы Кастильской.","en":"The Spanish Empire, sometimes referred to as the Hispanic Monarchy or the Catholic Monarchy, was a colonial empire that existed between 1492 and 1976. In conjunction with the Portuguese Empire, it ushered in the European Age of Discovery. It achieved a global scale, controlling vast portions of the Americas, Africa, various islands in Asia and Oceania, as well as territory in other parts of Europe. It was one of the most powerful empires of the early modern period, becoming known as \"the empire on which the sun never sets\"."},"wikipedia":{"ru":"https://ru.wikipedia.org/wiki/%D0%98%D1%81%D0%BF%D0%B0%D0%BD%D1%81%D0%BA%D0%B0%D1%8F_%D0%B8%D0%BC%D0%BF%D0%B5%D1%80%D0%B8%D1%8F","en":"https://en.wikipedia.org/wiki/Spanish_Empire"},"wikidata":"Q80702"}